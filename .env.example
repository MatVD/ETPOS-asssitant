ETPOS_ENV=development
ETPOS_HOST=127.0.0.1
ETPOS_PORT=8787
ETPOS_DATA_DIR=./data
ETPOS_SNAPSHOT_DIR=./snapshots
ETPOS_BACKUP_DIR=./backups
ETPOS_BACKUP_RETENTION_DAYS=30
# 0 = conserver toutes les versions pour préserver les anciennes citations
ETPOS_DOCS_HISTORY_KEEP=0
ETPOS_COOKIE_SECURE=false
# Origine publique exacte en production, ex. https://agent.matblock.com
ETPOS_PUBLIC_ORIGIN=
ETPOS_SESSION_HOURS=12

# mock = retrieval/citations sans LLM ; codex = Codex CLI authentifie avec ChatGPT
ETPOS_PROVIDER=mock

# Codex CLI. Aucune cle API OpenAI n'est utilisee.
CODEX_BINARY=codex
# Laisser vide pour utiliser le modele par defaut de Codex.
CODEX_MODEL=
# Optionnel : repertoire d'authentification Codex. Sinon ~/.codex du compte courant.
# CODEX_HOME=/home/etpos-assistant/.codex
CODEX_TIMEOUT_SECONDS=120
